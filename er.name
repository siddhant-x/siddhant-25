user.name=siddhant-x
user.email=siddhantsharmaa25@gmail.com
gpg.program=/.codespaces/bin/gh-gpgsign
init.defaultbranch=main
credential.helper=/.codespaces/bin/gitcredential_github.sh
filter.lfs.clean=git-lfs clean -- %f
filter.lfs.smudge=git-lfs smudge -- %f
filter.lfs.process=git-lfs filter-process
filter.lfs.required=true
core.repositoryformatversion=0
core.filemode=true
core.bare=false
core.logallrefupdates=true
remote.origin.url=https://github.com/siddhant-x/siddhant-25
remote.origin.fetch=+refs/heads/*:refs/remotes/origin/*
branch.main.remote=origin
branch.main.merge=refs/heads/main
branch.main.vscode-merge-base=origin/main
lfs.repositoryformatversion=0
branch.feature-login.vscode-merge-base=origin/main
branch.feature-login.remote=origin
branch.feature-login.merge=refs/heads/feature-login
lfs.https://github.com/siddhant-x/siddhant-25.git/info/lfs.access=basic
branch.feature-signup.vscode-merge-base=origin/main
branch.feature-signup.remote=origin
branch.feature-signup.merge=refs/heads/feature-signup
branch.feature-dashboard.remote=origin
branch.feature-dashboard.merge=refs/heads/feature-dashboard
branch.feature-dashboard.vscode-merge-base=origin/main
